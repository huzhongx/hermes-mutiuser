+def _discover_prm_sync(server_url: str) -> Optional[ProtectedResourceMetadata]:
+    """Pre-fetch Protected Resource Metadata from the well-known endpoint.
+
+    Uses the BASE well-known URL only (no path suffix). Some servers
+    (Notion) serve different PRM at the path-specific URL — the path-
+    specific PRM has a resource value (e.g. ``https://mcp.notion.com/mcp``)
+    that the authorization server rejects. The base PRM has the canonical
+    resource (``https://mcp.notion.com``) that the authorization server
+    accepts.
+
+    The MCP SDK's runtime discovery will overwrite our pre-set PRM with
+    the path-specific one — we prevent this by overriding
+    ``context.get_resource_url`` to always return our pre-fetched value.
+    """
+    try:
+        parsed = urlparse(server_url)
+        well_known = f"{parsed.scheme}://{parsed.netloc}/.well-known/oauth-protected-resource"
+        with httpx.Client(timeout=5.0) as client:
+            resp = client.get(well_known)
+        if resp.status_code != 200:
+            return None
+        data = resp.json()
+        return ProtectedResourceMetadata.model_validate(data)
+    except Exception:
+        return None
+
+
