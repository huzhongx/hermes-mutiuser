+            ``application/x-www-form-urlencoded`` and stash the dict back
+            on the response so the SDK's existing parser sees valid JSON.
+            """
+            try:
+                return await super()._handle_token_response(response)
+            except Exception as exc:
+                # Only fall back for "Invalid token response" / JSON-decode errors.
+                msg = str(exc)
+                if "Invalid token response" not in msg and "json_invalid" not in msg:
+                    raise
+                import json as _json
+                from urllib.parse import parse_qs
+                content = await response.aread()
+                # Detect: starts with "key=value&..." (form-urlencoded)
+                try:
+                    text = content.decode("utf-8") if isinstance(content, bytes) else content
+                except Exception:
