diff --git a/agent/conversation_compression.py b/agent/conversation_compression.py
index 913c0e25d..db82a3cb1 100644
--- a/agent/conversation_compression.py
+++ b/agent/conversation_compression.py
@@ -504,6 +504,14 @@ def compress_context(
             old_title = agent._session_db.get_session_title(agent.session_id)
             # Trigger memory extraction on the old session before it rotates.
             agent.commit_memory_session(messages)
+            # Flush any pending messages for the old session BEFORE it is
+            # closed.  Without this, messages accumulated between the
+            # previous flush and this compression are silently lost because
+            # _persist_session only runs at turn-exit, but mid-turn
+            # compressions can chain (each API call + tool response may
+            # exceed the token threshold again), closing each intermediate
+            # session before the turn ever finishes.
+            agent._flush_messages_to_session_db(messages)
             agent._session_db.end_session(agent.session_id, "compression")
             old_session_id = agent.session_id
             agent.session_id = f"{datetime.now().strftime('%Y%m%d_%H%M%S')}_{uuid.uuid4().hex[:6]}"
diff --git a/hermes_cli/mcp_config.py b/hermes_cli/mcp_config.py
index 17b6c0329..6b13dc00d 100644
--- a/hermes_cli/mcp_config.py
+++ b/hermes_cli/mcp_config.py
@@ -533,6 +533,20 @@ def cmd_mcp_list(args=None):
     print(f"  {'─' * 16} {'─' * 30} {'─' * 12} {'─' * 10}")
 
     for name, cfg in servers.items():
+        # Defensive: users sometimes stuff a raw string into mcp_servers.NAME
+        # via `hermes config set` (or hand-edited YAML), which previously
+        # crashed the whole list with AttributeError on `cfg.get(...)`.
+        # Coerce string shorthand to {url: str}; skip anything else with a
+        # warning instead of aborting the listing.
+        if isinstance(cfg, str):
+            cfg = {"url": cfg}
+        elif not isinstance(cfg, dict):
+            _warning(
+                f"Skipping malformed MCP entry '{name}': "
+                f"expected dict, got {type(cfg).__name__}"
+            )
+            continue
+
         # Transport info
         if "url" in cfg:
             url = cfg["url"]
