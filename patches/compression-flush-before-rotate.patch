diff --git a/tools/mcp_oauth.py b/tools/mcp_oauth.py
index 04d20be76..afc857697 100644
--- a/tools/mcp_oauth.py
+++ b/tools/mcp_oauth.py
@@ -901,7 +901,26 @@ def _configure_callback_port(cfg: dict, storage: "HermesTokenStorage | None" = N
         cached_port = _port_from_cached_client(storage)
         if cached_port is not None:
             requested = cached_port
-    port = _find_free_port() if requested == 0 else requested
+    if requested == 0:
+        port = _find_free_port()
+    else:
+        # Validate the requested port is actually bindable — on multi-user
+        # hosts multiple Hermes processes may share the same fixed
+        # redirect_port (e.g. 47892).  If it's already taken, fall back to a
+        # free port so the OAuth flow can still proceed.
+        port = requested
+        try:
+            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+                s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+                s.bind(("127.0.0.1", requested))
+        except OSError:
+            logger.warning(
+                "OAuth callback port %d is already in use, falling back to a "
+                "free port for server '%s'",
+                requested,
+                storage._server_name if storage else "?",
+            )
+            port = _find_free_port()
     cfg["_resolved_port"] = port
     _oauth_port = port  # legacy consumer: _wait_for_callback reads this
     return port
diff --git a/tools/mcp_tool.py b/tools/mcp_tool.py
index 51c740d88..aaa4f89dd 100644
--- a/tools/mcp_tool.py
+++ b/tools/mcp_tool.py
@@ -258,7 +258,13 @@ if _MCP_AVAILABLE and not _MCP_MESSAGE_HANDLER_SUPPORTED:
 # ---------------------------------------------------------------------------
 
 _DEFAULT_TOOL_TIMEOUT = 120      # seconds for tool calls
-_DEFAULT_CONNECT_TIMEOUT = 60    # seconds for initial connection per server
+# Default per-server initial connection timeout. Servers connect in parallel
+# (see register_mcp_servers._discover_all), so a slow/broken server only
+# blocks its own slot — but a too-long timeout (was 60s) × 3 retries = 3min
+# per dead server still drags bootstrap.
+# 10s is plenty for a healthy stdio/HTTP MCP to start up; broken ones fail
+# fast so the broker can report MCP ready sooner.
+_DEFAULT_CONNECT_TIMEOUT = 10    # seconds for initial connection per server
 _MAX_RECONNECT_RETRIES = 5
 _MAX_INITIAL_CONNECT_RETRIES = 3 # retries for the very first connection attempt
 _MAX_BACKOFF_SECONDS = 60
