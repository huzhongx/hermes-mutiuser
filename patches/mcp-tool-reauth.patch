+def disconnect_mcp_server(name: str) -> bool:
+    """Disconnect a single MCP server at runtime.
+
+    Shuts down the server task, deregisters its tools, and cleans up
+    circuit-breaker state.  Returns True if the server was connected,
+    False if it was not found in the runtime registry.
+    """
+    with _lock:
+        server = _servers.pop(name, None)
+    if server is None:
+        return False
+
+    async def _do_shutdown():
+        try:
+            await server.shutdown()
+        except Exception as exc:
+            logger.debug("Error shutting down MCP server '%s': %s", name, exc)
+
+    with _lock:
+        loop = _mcp_loop
+    if loop is not None and loop.is_running():
+        from agent.async_utils import safe_schedule_threadsafe
+        future = safe_schedule_threadsafe(
+            _do_shutdown(), loop,
+            logger=logger,
+            log_message="MCP disconnect: failed to schedule",
+        )
+        if future is not None:
+            try:
+                future.result(timeout=15)
+            except BaseException as exc:
+                logger.debug("Error during MCP server '%s' shutdown: %s", name, exc)
+
+    # Clean up circuit-breaker and parallel-safe state
+    _server_error_counts.pop(name, None)
+    _server_breaker_opened_at.pop(name, None)
+    _parallel_safe_servers.discard(sanitize_mcp_name_component(name))
+
+    logger.info("MCP server '%s' disconnected", name)
+    return True
+
