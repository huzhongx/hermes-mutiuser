+def _get_or_create_callback_server(port: int) -> dict:
+    """Return (and lazily start) the persistent callback server for *port*.
+
+    The returned entry contains:
+      * ``server`` — the ``HTTPServer`` instance
+      * ``thread`` — daemon thread running ``serve_forever``
+      * ``current_result`` — mutable dict shared between the HTTP handler
+        and the awaiting flow's ``_wait_for_callback`` coroutine
+      * ``lock`` — guards mutations of ``current_result``
+    """
+    with _callback_servers_lock:
+        existing = _callback_servers.get(port)
+        if existing is not None:
+            return existing
+
+        result: dict = {"auth_code": None, "state": None, "error": None}
+        lock = threading.Lock()
+
+        class _PersistentCallbackHandler(BaseHTTPRequestHandler):
+            def do_GET(self) -> None:  # noqa: N802
+                params = parse_qs(urlparse(self.path).query)
+                code = params.get("code", [None])[0]
+                state = params.get("state", [None])[0]
+                error = params.get("error", [None])[0]
+
+                with lock:
+                    cur = result
+                    if cur is not None:
+                        cur["auth_code"] = code
+                        cur["state"] = state
+                        cur["error"] = error
+
+                # Reflect the callback arrival in the pending-flows dict so
+                # the HTTP status endpoint reports ``completed`` (or
+                # ``failed``) instead of leaving the flow stuck on
+                # ``awaiting_callback`` for the rest of its TTL.
+                if code:
+                    mark_oauth_flow_completed(port)
+                elif error:
+                    mark_oauth_flow_failed(port, error)
+
+                body = (
+                    "<html><body><h2>Authorization Successful</h2>"
+                    "<p>You can close this tab and return to Hermes.</p></body></html>"
+                ) if code else (
+                    "<html><body><h2>Authorization Failed</h2>"
+                    f"<p>Error: {error or 'unknown'}</p></body></html>"
+                )
+                self.send_response(200)
+                self.send_header("Content-Type", "text/html; charset=utf-8")
+                self.end_headers()
+                self.wfile.write(body.encode())
+
+            def log_message(self, fmt: str, *args: Any) -> None:  # noqa: N802
+                logger.debug("OAuth callback: %s", fmt % args)
+
+        server = HTTPServer(("127.0.0.1", port), _PersistentCallbackHandler)
+        # SO_REUSEADDR lets a fresh flow rebind quickly even if a previous
+        # incarnation is still draining in TIME_WAIT.
+        server.allow_reuse_address = True
+        server.daemon_threads = True
+        thread = threading.Thread(
+            target=server.serve_forever,
+            daemon=True,
+            name=f"oauth-callback-{port}",
+        )
+        thread.start()
+
+        entry = {
+            "server": server,
+            "thread": thread,
+            "current_result": result,
+            "lock": lock,
+        }
+        _callback_servers[port] = entry
+        logger.info("Started persistent OAuth callback server on port %d", port)
+        return entry
+
