+def get_pending_oauth_authorization_url(server_name: str | None = None) -> dict | None:
+    """Return the most recent pending OAuth flow's authorization URL.
+
+    Called by the HTTP API endpoint (Scenario A polling) and by
+    _handle_auth_error_and_retry (Scenario B).
+
+    If *server_name* is given, only return flows for that server.
+    """
+    with _pending_oauth_flows_lock:
+        for fid, flow in sorted(
+            _pending_oauth_flows.items(), key=lambda x: x[1].get("created_at", 0), reverse=True
+        ):
+            if flow.get("status") == "awaiting_callback":
+                if server_name and flow.get("server_name") != server_name:
+                    continue
+                return {
+                    "authorization_url": flow["authorization_url"],
+                    "callback_port": flow["callback_port"],
+                    "flow_id": fid,
+                }
+        return None
+
+
+def mark_oauth_flow_completed(callback_port: int) -> None:
+    """Mark an OAuth flow as completed (called after successful token save)."""
+    flow_id = f"flow-{callback_port}"
+    with _pending_oauth_flows_lock:
+        if flow_id in _pending_oauth_flows:
+            _pending_oauth_flows[flow_id]["status"] = "completed"
+
+
+def mark_oauth_flow_failed(callback_port: int, error: str) -> None:
+    """Mark an OAuth flow as failed (callback arrived with ``?error=...``)."""
+    flow_id = f"flow-{callback_port}"
+    with _pending_oauth_flows_lock:
+        if flow_id in _pending_oauth_flows:
+            _pending_oauth_flows[flow_id]["status"] = "failed"
+            _pending_oauth_flows[flow_id]["error"] = error
+
+
+def cleanup_expired_oauth_flows(max_age: float = 600) -> None:
+    """Remove expired OAuth flows from the pending dict."""
+    now = time.time()
+    with _pending_oauth_flows_lock:
+        expired = [
+            fid for fid, flow in _pending_oauth_flows.items()
+            if now - flow.get("created_at", 0) > max_age
+        ]
+        for fid in expired:
+            del _pending_oauth_flows[fid]
 
 
