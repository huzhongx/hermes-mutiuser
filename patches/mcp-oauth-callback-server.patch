+def _port_from_cached_client(storage: "HermesTokenStorage") -> int | None:
+    """Extract the callback port from a cached client.json redirect_uri.
+
+    Returns None if no client info is cached or the URI doesn't match
+    the expected pattern.
+    """
+    import json as _json
+    try:
+        client_path = storage._client_info_path()
+        if not client_path.exists():
+            return None
+        data = _json.loads(client_path.read_text())
+        uris = data.get("redirect_uris")
+        if not uris:
+            return None
+        uri = uris[0]
+        # Extract port from the last segment: .../callback or :{port}/callback
+        from urllib.parse import urlparse
+        parsed = urlparse(uri)
+        # path is like /hermes/mcp-oauth-cb/59849/callback
+        parts = parsed.path.rstrip("/").split("/")
+        # Walk backwards to find a numeric segment
+        for part in reversed(parts):
+            if part.isdigit():
+                port = int(part)
+                if 1024 < port < 65536:
+                    return port
+        # Fallback: use the URL's port (for localhost URIs)
+        if parsed.port:
+            return parsed.port
+    except Exception:
+        pass
+    return None
