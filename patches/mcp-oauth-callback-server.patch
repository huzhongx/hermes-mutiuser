+def _reset_callback_result(port: int) -> dict:
+    """Reset the persistent server's result dict for a fresh OAuth flow.
+
+    Returns the cleared dict so the caller can poll it directly without an
+    extra lock acquisition.
+    """
+    entry = _callback_servers.get(port)
+    if entry is None:
+        return {"auth_code": None, "state": None, "error": None}
+    with entry["lock"]:
+        entry["current_result"]["auth_code"] = None
+        entry["current_result"]["state"] = None
+        entry["current_result"]["error"] = None
+        return entry["current_result"]
