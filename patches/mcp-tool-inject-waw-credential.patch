+# ---------------------------------------------------------------------------
+# waw MCP credential injection
+# ---------------------------------------------------------------------------
+
+# Cache: inject_waw_credential token per waw auth token (same TTL pattern as
+# the MCP servers themselves use).  Avoids re-fetching on every server spawn.
+_waw_cred_inject_cache: Dict[str, dict] = {}
+_WAW_CRED_INJECT_TTL = 300  # 5 minutes, matches MCP server cache TTL
+
+
+async def _fetch_waw_credential_for_env(credential_kind: str = "miaozhao-cuser") -> str:
+    """Fetch accessToken from waw MCP for env injection.
+
+    Reads waw MCP server config (URL + auth header) from the same config.yaml
+    that defines the MCP servers, performs a lightweight SSE handshake + single
+    credential.get call, and returns the accessToken string.
+
+    *credential_kind* is passed as the ``kind`` argument to ``credential.get``
+    (e.g. ``miaozhao-cuser`` for talent, ``miaozhao-uc`` for hiring).
+
+    Cached per (waw auth token, kind) pair with a 5-minute TTL to avoid
+    redundant handshakes when multiple MCP servers share the same config.
+
+    Returns the accessToken string, or "" if unavailable.
+    """
+    try:
+        from hermes_cli.config import load_config
+        full_config = load_config()
+        waw_cfg = (full_config.get("mcp_servers") or {}).get("waw")
+        if not waw_cfg:
+            logger.debug("inject_waw_credential: no waw MCP server configured")
+            return ""
+
+        waw_url = waw_cfg.get("url", "")
+        waw_headers = waw_cfg.get("headers", {})
+        auth_token = waw_headers.get("Authorization", "")
+        if not auth_token.startswith("Bearer "):
+            logger.debug("inject_waw_credential: no Bearer token in waw config")
+            return ""
+        # Extract just the token part for cache key
+        bare_token = auth_token[7:]
+
+        # Check cache (keyed by token + kind to isolate hiring vs talent)
+        cache_key = f"{bare_token}:{credential_kind}"
+        cached = _waw_cred_inject_cache.get(cache_key)
+        if cached and (time.time() - cached["ts"]) < _WAW_CRED_INJECT_TTL:
+            return cached["token"]
+
+        # Perform SSE handshake + credential.get
+        import httpx
+        headers = {
+            "Content-Type": "application/json",
+            "Accept": "application/json, text/event-stream",
+            "Authorization": auth_token,
+        }
+        timeout = httpx.Timeout(15.0, connect=10.0)
+
+        async with httpx.AsyncClient(timeout=timeout, follow_redirects=True) as client:
+            # Step 1: initialize
+            resp = await client.post(waw_url, json={
+                "jsonrpc": "2.0", "id": 1, "method": "initialize",
+                "params": {
+                    "protocolVersion": "2024-11-05", "capabilities": {},
+                    "clientInfo": {"name": "hermes-cred-injector", "version": "1.0"},
+                },
+            }, headers=headers)
+            resp.raise_for_status()
+
+            # Step 2: initialized notification
+            await client.post(waw_url, json={
+                "jsonrpc": "2.0", "method": "notifications/initialized",
+            }, headers=headers)
+
+            # Step 3: credential.get
+            resp = await client.post(waw_url, json={
+                "jsonrpc": "2.0", "id": 2, "method": "tools/call",
+                "params": {
+                    "name": "credential.get",
+                    "arguments": {"kind": credential_kind, "purpose": "mcp-env-injection"},
+                },
+            }, headers=headers)
+            resp.raise_for_status()
+            body = resp.text
+
+        # Parse response (may be SSE data: lines or direct JSON)
+        result = None
+        for line in body.split("\n"):
+            line = line.strip()
+            if line.startswith("data: "):
+                payload = line[6:]
+                if payload == "[DONE]":
+                    continue
+                data = json.loads(payload)
+                result = data.get("result", data)
+                break
+        if result is None:
+            result = json.loads(body)
+
+        if "content" in result:
+            content_text = result["content"][0]["text"]
+            parsed = json.loads(content_text)
+        else:
+            parsed = result
+
+        ok = parsed.get("ok", False)
+        if not ok:
+            error = parsed.get("error", {})
+            logger.debug("inject_waw_credential: credential.get failed: %s", error)
+            return ""
+
+        api_token = parsed.get("data", {}).get("accessToken", "")
+        if not api_token:
+            logger.debug("inject_waw_credential: no accessToken in response")
+            return ""
+
+        # Cache it
+        _waw_cred_inject_cache[cache_key] = {"token": api_token, "ts": time.time()}
+        return api_token
+
+    except Exception as exc:
+        logger.debug("inject_waw_credential: failed to fetch: %s", exc)
+        return ""
+
+
