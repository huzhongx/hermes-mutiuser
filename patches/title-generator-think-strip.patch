diff --git a/agent/title_generator.py b/agent/title_generator.py
index 583a2cfc6..cb52028d4 100644
--- a/agent/title_generator.py
+++ b/agent/title_generator.py
@@ -88,6 +88,22 @@ def generate_title(
             main_runtime=main_runtime,
         )
         title = (response.choices[0].message.content or "").strip()
+        # Strip <think>...</think> reasoning chains. Some routers (and some
+        # reasoning-capable models) do not separate reasoning into a
+        # ``reasoning_content`` field and instead leak the full chain into
+        # ``content`` — without this the session title would become the
+        # model's deliberation rather than its final answer.
+        #
+        # Two cases (both seen in production titles):
+        # 1. Closed:   "<think>...</think>actual title" → take part after last </think>.
+        # 2. Truncated: "<think>...reasoning" (no </think>, cut off by max_tokens)
+        #    → the whole content is unfinished reasoning with no real title; discard
+        #    it so the caller falls back to a default title rather than showing the
+        #    model's deliberation. (Previously this case leaked through unchanged.)
+        if "</think>" in title:
+            title = title.rsplit("</think>", 1)[-1].strip()
+        elif title.lstrip().startswith("<think>"):
+            title = ""
         # Clean up: remove quotes, trailing punctuation, prefixes like "Title: "
         title = title.strip('"\'')
         if title.lower().startswith("title:"):
diff --git a/tests/agent/test_title_generator.py b/tests/agent/test_title_generator.py
