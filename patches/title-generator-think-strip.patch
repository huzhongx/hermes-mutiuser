@@ -77,6 +77,34 @@ class TestGenerateTitle:
             title = generate_title("my pod keeps crashing", "Let me look...")
             assert title == "Kubernetes Pod Debugging"
 
+    def test_strips_closed_think_block(self):
+        # Closed <think>...</think> followed by the real title.
+        # Some routers/models leak reasoning into content; take the part after </think>.
+        mock_response = MagicMock()
+        mock_response.choices = [MagicMock()]
+        mock_response.choices[0].message.content = (
+            "<think>The user wants a title about resumes.</think>\n简历诊断服务"
+        )
+
+        with patch("agent.title_generator.call_llm", return_value=mock_response):
+            title = generate_title("帮我看看简历", "好的,我来分析...")
+            assert title == "简历诊断服务"
+
+    def test_discards_truncated_think_block(self):
+        # Truncated reasoning: <think> with no closing </think> (cut off by max_tokens).
+        # The whole content is unfinished deliberation with no real title → discard
+        # (return None) so the caller keeps the default title instead of showing reasoning.
+        mock_response = MagicMock()
+        mock_response.choices = [MagicMock()]
+        mock_response.choices[0].message.content = (
+            "<think> The user wants me to generate a short, descriptive title "
+            "(3-7 words) for a conversation about resume diagnosis..."
+        )
+
+        with patch("agent.title_generator.call_llm", return_value=mock_response):
+            title = generate_title("简历诊断", "分析中...")
+            assert title is None
+
     def test_truncates_long_titles(self):
