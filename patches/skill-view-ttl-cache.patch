+# ── TTL cache for skill_view ──────────────────────────────────────────────
+# Avoids redundant full-content reloads within a single Hermes process.
+# Key: "name\tfile_path", Value: (monotonic_timestamp, full_result_json).
+# On cache hit, a compact "already loaded" hint is returned instead of the
+# full skill content, saving ~8-28K chars per duplicate call.
+_SKILL_VIEW_CACHE_TTL = 600.0          # 10 minutes
+_skill_view_cache: dict[str, tuple[float, str]] = {}
+_skill_view_cache_lock = threading.Lock()
+
+
+def skill_view_cache_invalidate(name: str = None):
+    """Invalidate the skill_view TTL cache.
+
+    Args:
+        name: If given, remove entries for that skill only (any file_path).
+              If None, clear the entire cache.
+    """
+    with _skill_view_cache_lock:
+        if name is None:
+            _skill_view_cache.clear()
+        else:
+            prefix = f"{name}\t"
+            keys_to_remove = [k for k in _skill_view_cache if k.startswith(prefix)]
+            for k in keys_to_remove:
+                del _skill_view_cache[k]
+
 
