+def _oauth_can_proceed() -> bool:
+    """Whether an OAuth flow can complete without a server-side TTY.
+
+    The CLI's non-interactive guard refuses to start a flow when there's no
+    TTY and no cached token — correct for a single-user CLI where the
+    authorization code arrives back over the same terminal. But on Hermes
+    Platform the flow is browser-driven and routed through the public nginx
+    callback (``HERMES_NGINX_DOMAIN``): the user authorizes in their own
+    browser and the broker forwards the callback to this process. No server
+    TTY is needed, so the guard must pass when a public callback route exists.
+    """
+    if _is_interactive():
+        return True
+    return bool(os.environ.get("HERMES_NGINX_DOMAIN", "").strip())
+
+
+def _set_oauth_server_name(server_name: str) -> None:
+    """Record the server name of the in-flight flow.
+
+    Both construction paths (``build_oauth_auth`` and the manager's
+    ``_build_provider``) call this so ``_redirect_handler`` tags the pending-
+    flow registry with the right server name — the dashboard's /oauth/start
+    matches a pending authorization URL back to the server by this name.
+    """
+    global _oauth_server_name
+    _oauth_server_name = server_name
+
