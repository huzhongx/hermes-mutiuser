+def _redirect_uri(port: int) -> str:
+    """The OAuth ``redirect_uri`` for this environment.
+
+    Behind nginx (``HERMES_NGINX_DOMAIN`` set) this is the PUBLIC state-routed
+    path the broker proxies; the user's browser redirects there and the broker
+    resolves ``state`` back to this process's local port. Without a public
+    domain we fall back to the upstream localhost listener (single-user /
+    interactive-with-paste / SSH-tunnel mode).
