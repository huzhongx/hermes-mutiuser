 _USER_SKIPPED_SENTINEL = "__hermes_user_skipped__"
 
 
+# ---------------------------------------------------------------------------
+# Multi-user callback routing (Hermes Platform)
+# ---------------------------------------------------------------------------
+# When running behind nginx (HERMES_NGINX_DOMAIN set) the OAuth redirect_uri
+# is the PUBLIC path ``https://{domain}/hermes/mcp-oauth/callback`` (no port):
+# the user's browser never reaches this process directly. nginx forwards the
+# callback to the broker, which resolves ``state`` -> ``port`` via the route
+# file written here and proxies to ``127.0.0.1:{port}/callback``. Each process
+# still binds its own random callback port locally; the port is just never
+# exposed publicly, so multiple concurrent users no longer collide on a shared
+# registered port (the root cause of the old ``Address already in use``
+# failures — see docs/mcp-oauth-state-routing.md).
+_OAUTH_ROUTE_DIR = "/tmp/hermes_oauth_routes"
+
+# ``state`` of the in-flight flow, parsed from the authorization URL in
+# ``_redirect_handler``. Tracked module-globally (same legacy pattern as
+# ``_oauth_port``) so ``_wait_for_callback`` can delete the route file in its
+# finally block regardless of success/failure/skip.
+_oauth_state: str | None = None
+
+
+def _write_state_route(state: str, port: int) -> None:
+    """Persist ``{state} -> {port}`` so the broker can route the callback.
+
+    Atomic temp-file + ``os.replace``. Non-fatal: in local mode (no nginx)
+    the callback reaches the local listener directly and this file is never
+    read, so a write failure must not abort the OAuth flow.
+    """
+    try:
+        os.makedirs(_OAUTH_ROUTE_DIR, exist_ok=True)
+        path = os.path.join(_OAUTH_ROUTE_DIR, state)
+        tmp = f"{path}.tmp.{os.getpid()}"
+        with open(tmp, "w") as fh:
+            fh.write(str(port))
+        os.replace(tmp, path)
+    except OSError:
+        logger.debug("could not write OAuth state route for %s", state)
+
+
+def _cleanup_state_route(state: str | None) -> None:
+    """Remove the state route file after a flow completes, fails, or skips."""
+    if not state:
+        return
+    try:
+        os.unlink(os.path.join(_OAUTH_ROUTE_DIR, state))
+    except FileNotFoundError:
+        pass
+    except OSError:
+        logger.debug("could not remove OAuth state route for %s", state)
+
+
+# ---------------------------------------------------------------------------
+# Pending-flow registry (scenario B: agent 401 -> frontend "authorize" prompt)
+# ---------------------------------------------------------------------------
+# When the SDK's redirect handler fires we stash the authorization URL +
+# callback port here. ``mcp_tool``'s needs_reauth path reads it via
+# ``get_pending_oauth_authorization_url()`` so the frontend can prompt the
+# user to authorize in-browser (chat.html ``needs_reauth``/``oauth_url``).
+# Cleared on completion/failure.
+_pending_oauth_flows_lock = threading.Lock()
+# Keyed by callback port (one outstanding flow per process in practice).
+_pending_oauth_flows: dict[int, dict] = {}
+
+
+def register_pending_oauth_flow(
+    port: int, authorization_url: str, server_name: str, state: str | None
+) -> None:
+    with _pending_oauth_flows_lock:
+        _pending_oauth_flows[port] = {
+            "authorization_url": authorization_url,
+            "callback_port": port,
+            "server_name": server_name,
+            "state": state,
+            "created_at": time.time(),
+            "status": "awaiting_callback",
+        }
+
+
+def get_pending_oauth_authorization_url() -> dict | None:
+    """Return the most recent awaiting-callback flow, or None.
+
+    Used by ``mcp_tool``'s reauth path (scenario B) to surface an
+    ``oauth_url`` to the frontend alongside ``needs_reauth``.
+    """
+    with _pending_oauth_flows_lock:
+        if not _pending_oauth_flows:
+            return None
+        latest = max(
+            _pending_oauth_flows.values(), key=lambda f: f.get("created_at", 0)
+        )
+        if latest.get("status") != "awaiting_callback":
+            return None
+        return dict(latest)
+
+
+def mark_oauth_flow_completed(port: int) -> None:
+    with _pending_oauth_flows_lock:
+        flow = _pending_oauth_flows.pop(port, None)
+    if flow:
+        _cleanup_state_route(flow.get("state"))
+
+
+def mark_oauth_flow_failed(port: int) -> None:
+    with _pending_oauth_flows_lock:
+        flow = _pending_oauth_flows.pop(port, None)
+    if flow:
+        _cleanup_state_route(flow.get("state"))
+
+
