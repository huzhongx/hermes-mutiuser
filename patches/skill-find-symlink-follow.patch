+def _iter_skill_md(skills_dir):
+    """Yield SKILL.md paths under *skills_dir*, following symlinked skill dirs.
+
+    Python < 3.13 ``rglob`` does not descend into symlinked directories, so
+    workspace skills mounted as symlinks (the broker's per-user layout, where
+    every business skill under ``hermes_home/skills/`` is a symlink to
+    ``~/.hermes/skills/``) are invisible to a plain ``rglob``. Walk top-level
+    entries explicitly and ``rglob`` each child, resolving symlinks first —
+    matching the behaviour of ``skills_list``/``skill_view`` which already
+    ``.resolve()`` their paths.
+    """
+    try:
+        entries = list(skills_dir.iterdir())
+    except OSError:
+        return
+    for entry in entries:
+        try:
+            target = entry.resolve() if entry.is_symlink() else entry
+        except (OSError, RuntimeError):
+            target = entry
+        try:
+            if not target.is_dir():
+                continue
+        except OSError:
+            continue
+        for skill_md in target.rglob("SKILL.md"):
+            yield skill_md
+
