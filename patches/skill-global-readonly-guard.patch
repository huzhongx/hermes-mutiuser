+def _is_global_skill_writable_check() -> bool:
+    """True when the operator has opted this process into writing global skills.
+
+    Mirrors the ``HERMES_SKILLS_WRITABLE_GLOBAL`` escape hatch used by
+    ``skill_manager_tool._managed_skill_write_guard``. When set, file/patch/
+    execute_code writes into the global skills root are allowed (platform
+    operator curating the shared tree); otherwise they are denied.
+    """
+    val = os.getenv("HERMES_SKILLS_WRITABLE_GLOBAL", "")
+    return val.lower() in ("1", "true", "yes", "on")
