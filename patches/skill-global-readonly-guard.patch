+def _managed_skill_write_guard(skill_dir: Path) -> Optional[str]:
+    """Refuse mutating a skill that is reached only via a symlink to a
+    read-only global/shared skills root.
+
+    The multi-tenant broker exposes system skills to each user as a *symlink*
+    inside that user's private ``HERMES_HOME/skills/`` directory. Without this
+    guard, an agent ``skill_manage`` call (edit/patch/write_file/remove_file)
+    — or the matching dashboard HTTP endpoint — resolves through the symlink
+    and writes the *global* skill body, so any logged-in user can rewrite a
+    skill seen by every other tenant. This is the write-path counterpart of
+    the delete-path ``_validate_delete_target`` symlink defense.
+
+    Rule: a skill is globally managed (read-only) when its resolved real path
+    is NOT contained within this process's own private skills root
+    (``SKILLS_DIR``). That holds exactly when the discovered directory is a
+    symlink (or sits behind one) pointing outside ``HERMES_HOME/skills``.
+
+    Operators can opt a process out (e.g. the platform admin that curates the
+    global skills tree) by exporting ``HERMES_SKILLS_WRITABLE_GLOBAL=1``.
+
+    Returns a refusal message string, or ``None`` when the write is safe.
+    """
+    if is_truthy_value(os.environ.get("HERMES_SKILLS_WRITABLE_GLOBAL", "")):
+        return None
+
+    try:
+        private_root = SKILLS_DIR.resolve(strict=False)
+        resolved = Path(skill_dir).resolve(strict=False)
+    except OSError:
+        return None
+
+    # A skill whose real location escapes the private skills root was reached
+    # via a symlink/redirect from elsewhere (the global tree). Treat as
+    # read-only. We compare on resolved (symlink-followed) paths so even an
+    # ancestor symlink cannot smuggle a write through.
+    try:
+        resolved.relative_to(private_root)
+    except ValueError:
+        return (
+            f"Refusing to modify '{skill_dir}': it is a shared/global skill "
+            f"exposed read-only via symlink (real path {resolved} is outside "
+            f"this workspace's skills root {private_root}). Global skills can "
+            f"only be changed by a platform operator. To customize, copy the "
+            f"skill into your own workspace first."
+        )
+    return None
+
+
