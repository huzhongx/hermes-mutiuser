# ──────────────────────────────────────────────────────────────────────────
# Hermes Platform 环境变量示例(broker 生产模式)
# 用法:cp .env.example .env,然后编辑 .env 填真实值
# ⚠️ .env 不要提交到 git(已在 .gitignore)
#
# 启动:见 memory/reference_broker_restart.md 的 env -i 命令
#      (set -a && source .env && set +a && exec python3 hermes_broker.py)
#
# 注:PostgreSQL / Redis / API Server / Rate Limiting 段已移除 —— 当前为 broker
#    模式,这些变量(给 api_server.py 多租户 SaaS 模式用)无人读取。如需切回 SaaS
#    模式,参考 CLAUDE.md 的 "Mode 2: Platform API" 章节。
# ──────────────────────────────────────────────────────────────────────────

# ── Process Manager(broker 核心进程管理)──
# per-user 工作目录根(每个用户一个子目录,存放 hermes_home / session 数据)
SESSIONS_ROOT=/tmp/hermes_sessions
# per-user dashboard 进程端口范围(BASE_PORT ~ MAX_PORT)
BASE_PORT=9119
MAX_PORT=9200
# 最大并发用户/进程数
MAX_SESSIONS=80
# 进程空闲回收超时(秒);10800 = 3 小时
IDLE_TIMEOUT=10800
# 预热池大小(spawn 时预启动的 dashboard 进程数)
WARM_POOL_SIZE=5

# ── HERMES_NGINX_DOMAIN:决定 broker 返回的 ws_url/http_url 形式 ──
#
# 两种模式(留空/填值 二选一):
#
# 1) 留空(默认,直连模式):
#    HERMES_NGINX_DOMAIN=
#    broker 走 else 分支 → ws_url = ws://127.0.0.1:{port}/api/ws?token=...
#    适用:本机调试 / 客户端能直连 per-user agent 端口(9119-9200)
#
# 2) 填真实域名(生产 / nginx 反代模式):
#    HERMES_NGINX_DOMAIN=hermes.yourdomain.com
#    broker 走 nginx_domain 分支 → ws_url = wss://hermes.yourdomain.com/hermes/ws/{port}/...
#    适用:对外服务,客户端经 nginx 反代访问(需要宿主机 nginx + SSL)
#    同时也是 MCP OAuth 公网回调地址的域名(https://{domain}/hermes/mcp-oauth/callback)
HERMES_NGINX_DOMAIN=

# ── 可选:TCR 镜像命名空间(若用 B 镜像源)──
# TCR_NAMESPACE=your-tcr-namespace
